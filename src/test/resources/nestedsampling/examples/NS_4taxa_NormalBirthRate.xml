<?xml version='1.0' encoding='UTF-8'?>
<beast version="2.8"
       namespace="beast.core:beast.core.util:beast.evolution.alignment:beast.evolution.nuc:beast.evolution.operators:beast.evolution.sitemodel:beast.evolution.substitutionmodel:beast.evolution.tree.coalescent:beast.base.core:beast.base.evolution.alignment:beast.base.evolution.likelihood:beast.base.evolution.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.inference:beast.base.inference.operator:beast.base.inference.util:beast.pkgmgmt"
       beautitemplate="Standard"
       beautistatus=""
       required="">

    <data id="dna" name="alignment">
                    <sequence id="seq_Cow" taxon="Cow" totalcount="4" value="---------------------TAA"/>
                    <sequence id="seq_Human" taxon="Human" totalcount="4" value="---------------------GGGCCCGTATTTACCCTATAG"/>
                    <sequence id="seq_Mouse" taxon="Mouse" totalcount="4" value="---------------------TAA"/>
                    <sequence id="seq_Whale" taxon="Whale" totalcount="4" value="---------------------TAA"/>
                </data>

<!--
SS 1000 steps: marginal L estimate = -2349.5333124902536

NS paramCountFactor = 1
ML: -2350.4047769214417 Information: 14.5551218399537
Finished in 33565 steps!

NS paramCountFactor = 2
Marginal likelihood: -2351.221347369531 (SD=0.1304383979258318) 
Information: 15.76404944532901

NS paramCountFactor = 10
Marginal likelihood: -2348.805635094754(SD=0.11524998504604511)
Information: 13.992136145042423

NS autoSubChainLength = false
ML: -2349.814260249774 Information: 14.442480805674677 (SD ~ 0.12)
-->

<run id="mcmc" spec="beast.gss.NS" subChainLength="10000" chainLength="250000" preBurnin="0" particleCount="100" epsilon="1e-10" autoSubChainLength="true" paramCountFactor="10" producePosterior="false">

    <state id="state" storeEvery="5000">
        <tree id="Tree.t:dna" name="stateNode">
            <taxonset id="TaxonSet.dna" spec="TaxonSet">
                <alignment idref="dna"/>
            </taxonset>
        </tree>
        <parameter id="birthRate.t:dna" name="stateNode" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</parameter>
        <parameter id="kappa.s:dna" name="stateNode" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">2.0</parameter>
        <parameter id="freqParameter.s:dna" dimension="4" name="stateNode" spec="beast.base.spec.inference.parameter.SimplexParam">0.25</parameter>
    </state>

    <!-- root prior N(0.19, 0.05)  -->
    <init id="RandomTree.t:dna" spec="beast.base.spec.evolution.tree.coalescent.RandomTree"
          rootHeight="0.19" estimate="false" initial="@Tree.t:dna" taxa="@dna">
        <populationModel id="ConstantPopulation0.t:dna" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
            <parameter id="randomPopSize.t:dna" name="popSize" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</parameter>
        </populationModel>
    </init>

    <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">
        <distribution id="prior" spec="beast.base.inference.CompoundDistribution">
            <distribution id="YuleModel.t:dna" spec="beast.base.spec.evolution.speciation.YuleModel" birthDiffRate="@birthRate.t:dna" tree="@Tree.t:dna"/>
            <distribution id="YuleBirthRatePrior.t:dna" spec="beast.base.spec.inference.distribution.Normal" param="@birthRate.t:dna" mean="6.5" sigma="0.1"/>
            <distribution id="LogNormalDistributionModel.0" spec="beast.base.spec.inference.distribution.Normal" param="@kappa.s:dna" mean="2.5" sigma="0.1"/>
            <distribution id="root.prior" spec="beast.base.spec.evolution.tree.MRCAPrior" monophyletic="true" tree="@Tree.t:dna">
                <taxonset id="root" spec="TaxonSet">
                    <taxon id="Cow" spec="Taxon"/>
                    <taxon id="Human" spec="Taxon"/>
                    <taxon id="Mouse" spec="Taxon"/>
                    <taxon id="Whale" spec="Taxon"/>
                </taxonset>
                <Normal name="distr" spec="beast.base.spec.inference.distribution.Normal" mean="0.19" sigma="0.05"/>
            </distribution>
        </distribution>
        <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution" useThreads="true">
            <distribution id="treeLikelihood.dna" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@dna" tree="@Tree.t:dna">
                <siteModel id="SiteModel.s:dna" spec="beast.base.spec.evolution.sitemodel.SiteModel">
                    <parameter id="mutationRate.s:dna" estimate="false" name="mutationRate" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</parameter>
                    <parameter id="gammaShape.s:dna" estimate="false" name="shape" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</parameter>
                    <parameter id="proportionInvariant.s:dna" estimate="false" name="proportionInvariant" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval">0.0</parameter>
                    <substModel id="hky.s:dna" spec="beast.base.spec.evolution.substitutionmodel.HKY" kappa="@kappa.s:dna">
                        <frequencies id="estimatedFreqs.s:dna" spec="beast.base.spec.evolution.substitutionmodel.Frequencies" frequencies="@freqParameter.s:dna"/>
                    </substModel>
                </siteModel>
                <branchRateModel id="StrictClock.c:dna" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                    <parameter id="clockRate.c:dna" estimate="false" name="clock.rate" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</parameter>
                </branchRateModel>
            </distribution>
        </distribution>
    </distribution>

    <operator id="YuleBirthRateScaler.t:dna" parameter="@birthRate.t:dna" scaleFactor="0.75" weight="1.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="YuleModelTreeScaler.t:dna" scaleFactor="0.5" tree="@Tree.t:dna" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

    <operator id="YuleModelTreeRootScaler.t:dna" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:dna" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

    <operator id="YuleModelUniformOperator.t:dna" tree="@Tree.t:dna" weight="30.0" spec="beast.base.evolution.operator.Uniform"/>

    <operator id="YuleModelSubtreeSlide.t:dna" spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" tree="@Tree.t:dna" weight="15.0"/>

    <operator id="YuleModelNarrow.t:dna" spec="Exchange" tree="@Tree.t:dna" weight="15.0"/>

    <operator id="YuleModelWide.t:dna" spec="Exchange" isNarrow="false" tree="@Tree.t:dna" weight="3.0"/>

    <operator id="YuleModelWilsonBalding.t:dna" spec="WilsonBalding" tree="@Tree.t:dna" weight="3.0"/>

    <operator id="KappaScaler.s:dna" parameter="@kappa.s:dna" scaleFactor="0.5" weight="0.5" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="FrequenciesExchanger.s:dna" spec="beast.base.spec.inference.operator.DeltaExchangeOperator" delta="0.01" weight="0.5">
        <parameter idref="freqParameter.s:dna"/>
    </operator>

    <logger id="tracelog" fileName="dna.log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
        <log idref="posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
        <log idref="treeLikelihood.dna"/>
        <log id="TreeHeight.t:dna" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:dna"/>
        <log idref="YuleModel.t:dna"/>
        <log idref="birthRate.t:dna"/>
        <log idref="kappa.s:dna"/>
        <log idref="root.prior"/>
        <log idref="freqParameter.s:dna"/>
    </logger>

    <logger id="screenlog" logEvery="100000">
        <log idref="posterior"/>
        <log id="ESS.0" spec="beast.base.spec.inference.util.ESS" arg="@posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
    </logger>

    <logger id="treelog.t:dna" fileName="$(tree).trees" logEvery="1000" mode="tree">
        <log id="TreeWithMetaDataLogger.t:dna" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:dna"/>
    </logger>

</run>

</beast>
